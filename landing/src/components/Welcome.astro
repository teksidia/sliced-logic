---
import { Button } from "@/components/ui/button";
const appUrl = import.meta.env.PUBLIC_APP_URL;
---

<section>
  <div class="text-center space-y-8">
    <h1 class="text-5xl md:text-7xl font-bold text-white text-balance">
      Welcome to Our Site
    </h1>
    <p class="text-xl text-gray-300 max-w-2xl mx-auto text-pretty">
      A beautifully simple layout with a sticky header, gradient background, and
      a clean footer. Built with pure Tailwind CSS.
    </p>
    <div class="flex gap-4 justify-center pt-4">
      <a href={appUrl} data-astro-prefetch="hover">
        <Button variant="default" size="lg"> Get Started </Button>
      </a>
    </div>
  </div>

  {/* Feature Cards */}
  <div class="grid md:grid-cols-3 gap-6 mt-24">
    {
      [
        {
          title: "Fast",
          description: "Lightning quick performance out of the box",
        },
        {
          title: "Modern",
          description: "Built with the latest web technologies",
        },
        { title: "Simple", description: "Clean and intuitive design patterns" },
      ].map((feature) => (
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-6 text-white">
          <h3 class="text-xl font-semibold mb-2">{feature.title}</h3>
          <p class="text-gray-300">{feature.description}</p>
        </div>
      ))
    }
  </div>
</section>
